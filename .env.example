# ===========================================
# FitCalendar Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
NX_DB_HOST=localhost
NX_DB_PORT=5432
NX_DB_NAME=fitcalendar
NX_DB_USER=postgres
NX_DB_PASS=your_password_here
NX_DB_SCHEMA=public
NX_DB_LOGGING=warn
# Set to "true" for managed Postgres reached over the public internet (Neon, Render,
# Supabase…) which requires TLS. Leave unset/false for local Docker or a provider's
# private network (e.g. Railway internal).
NX_DB_SSL=false
# Connection pool ceiling. Bump if running multiple API replicas against the same Postgres.
NX_DB_POOL_MAX=10
# Server-side kill switch for runaway queries (ms). Anything slower is a bug.
NX_DB_STATEMENT_TIMEOUT_MS=30000
# Kills sessions that BEGIN but never COMMIT/ROLLBACK (ms) so they can't pin a row lock forever.
NX_DB_IDLE_TX_TIMEOUT_MS=60000
# Full database URL (alternative to individual settings)
DATABASE_URL=postgresql://${NX_DB_USER}:${NX_DB_PASS}@${NX_DB_HOST}:${NX_DB_PORT}/${NX_DB_NAME}

# ===========================================
# API Configuration
# ===========================================
NODE_ENV=development
NX_BE_API_FITCALENDAR_SERVICE_PORT=3020
NX_BE_API_FITCALENDAR_SERVICE_PREFIX=api
API_URL=http://localhost:3020

# ===========================================
# CORS Configuration
# ===========================================
# Allowed origins for CORS (production URLs)
CORS_ORIGIN_MINI_APP=https://app.fitcalendar.ru
CORS_ORIGIN_ADMIN=https://admin.fitcalendar.ru

# Public URL of the admin SPA, used to build the set-password link in admin
# invite/reset emails. Required for those emails (else the copy-link is used).
ADMIN_APP_URL=https://admin.fitcalendar.ru

# ===========================================
# Telegram Configuration
# ===========================================
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Webhook secret for signature validation
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
# Mini App URL (for the bot's web app button)
MINI_APP_URL=https://app.fitcalendar.ru

# ===========================================
# Authentication (JWT)
# ===========================================
JWT_SECRET=replace-me-with-a-32-char-random-string
JWT_EXPIRES_IN=7d

# ===========================================
# Cloudinary (Image Upload)
# ===========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===========================================
# Geocoding (Yandex Geocoder)
# ===========================================
# Powers the admin "Определить координаты по адресу" button. Free tier ~1000
# req/day. Get a key at https://developer.tech.yandex.ru (Geocoder API / JavaScript API).
# Without it, the geocode endpoint returns 503 and admins enter coordinates manually.
YANDEX_GEOCODER_API_KEY=your_yandex_geocoder_key

# ===========================================
# SMTP (Yandex 360) — доставка ссылок приглашения/сброса админам по email.
# Все переменные опциональны: если не заданы HOST/USER/PASS/FROM, письма не
# шлются (остаётся ручной copy-link). Пароль — «пароль приложения» из Yandex.
# Ссылка в письме строится из ADMIN_APP_URL, поэтому он должен быть задан.
# ===========================================
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@fit-calendar.ru
SMTP_PASS=your_yandex_app_password
SMTP_FROM=FitCalendar <noreply@fit-calendar.ru>

# ===========================================
# Swagger Documentation
# ===========================================
NX_SWAGGER_PATH=/api/docs
NX_SWAGGER_EXPORT_PATH=/api/docs/json
# Gate Swagger UI. Set to "false" in production so the API schema isn't publicly discoverable.
SWAGGER_ENABLED=true

# ===========================================
# Frontend Configuration
# ===========================================
VITE_API_URL=http://localhost:3020/api
# Sentry DSNs for the admin and mini-app frontends. Leave blank in dev — Sentry
# init no-ops without a DSN. Required in production to surface frontend errors.
VITE_SENTRY_DSN_ADMIN=
VITE_SENTRY_DSN_MINI=
# Environment label and release tag forwarded to Sentry. Defaults to Vite's MODE.
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=

# ===========================================
# Monitoring & Logging
# ===========================================
LOG_LEVEL=info
SENTRY_DSN=

# ===========================================
# Redis (Optional - for caching/sessions)
# ===========================================
REDIS_URL=redis://localhost:6379
