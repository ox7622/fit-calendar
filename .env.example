# ===========================================
# FitCalendar Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
NX_DB_HOST=localhost
NX_DB_PORT=5432
NX_DB_NAME=fitcalendar
NX_DB_USER=postgres
NX_DB_PASS=your_password_here
NX_DB_SCHEMA=public
NX_DB_LOGGING=warn
# Full database URL (alternative to individual settings)
DATABASE_URL=postgresql://${NX_DB_USER}:${NX_DB_PASS}@${NX_DB_HOST}:${NX_DB_PORT}/${NX_DB_NAME}

# ===========================================
# API Configuration
# ===========================================
NODE_ENV=development
NX_API_PORT=3000
NX_API_PREFIX=api
API_URL=http://localhost:3000

# ===========================================
# Telegram Configuration
# ===========================================
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Mini App URL (for production)
TELEGRAM_MINI_APP_URL=https://your-domain.com

# ===========================================
# Authentication (JWT)
# ===========================================
JWT_SECRET=your_jwt_secret_here_min_32_characters
JWT_EXPIRES_IN=7d

# ===========================================
# Cloudinary (Image Upload)
# ===========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===========================================
# Swagger Documentation
# ===========================================
NX_SWAGGER_PATH=/api/docs
NX_SWAGGER_EXPORT_PATH=/api/docs/json

# ===========================================
# Frontend Configuration
# ===========================================
VITE_API_URL=http://localhost:3000/api

# ===========================================
# Monitoring & Logging
# ===========================================
LOG_LEVEL=info
SENTRY_DSN=

# ===========================================
# Redis (Optional - for caching/sessions)
# ===========================================
REDIS_URL=redis://localhost:6379
