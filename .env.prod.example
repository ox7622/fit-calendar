# Production env for the single-VPS docker-compose stack.
# Copy to `.env.prod` at the repo root and fill in, then run from the repo root:
#   docker compose --env-file .env.prod -f docker/docker-compose.prod.yml up -d --build
#
# Host/port/SSL, API_URL, MINI_APP_URL, CORS_*, prefix, NODE_ENV, SWAGGER are set
# by the compose file — only the values below are needed here.

# Domain — DNS api.<DOMAIN> / app.<DOMAIN> / admin.<DOMAIN> must point at this server.
DOMAIN=example.ru
ACME_EMAIL=you@example.ru

# Database (Postgres container + API). Use a strong password.
NX_DB_NAME=fitcalendar
NX_DB_USER=fitcalendar
NX_DB_PASS=CHANGE_ME_strong_db_password

# Secrets
JWT_SECRET=CHANGE_ME_at_least_32_chars_no_placeholder
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME

# Yandex geocoder (admin "Определить координаты по адресу")
YANDEX_GEOCODER_API_KEY=CHANGE_ME

# Cloudinary (photo uploads) — optional; leave blank to disable uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
