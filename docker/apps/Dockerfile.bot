# FitCalendar Bot Dockerfile
FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY dist/apps/bot/package.json dist/apps/bot/pnpm-lock.yaml* ./

# Install pnpm and production dependencies
RUN npm install -g pnpm && pnpm install --prod --frozen-lockfile

# Copy built application
COPY dist/apps/bot/ ./

CMD ["node", "main.js"]
