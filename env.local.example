# База данных
NX_DB_HOST=localhost
NX_DB_SCHEMA=public
NX_DB_LOGGING=all
# необходимо поменять на свои данные
NX_DB_PORT=4632
NX_DB_NAME=fitcalendar
NX_DB_USER=DB_USER_TO_CHANGE
NX_DB_PASS=DB_PASS_TO_CHANGE

# API (бэкенд)
NX_BE_API_FITCALENDAR_SERVICE_PORT=3020
NX_BE_API_FITCALENDAR_SERVICE_PREFIX=api
API_URL=http://localhost:3020

# Frontend (admin, mini-app) — куда фронт стучится за API.
# Для локальной разработки оставь localhost. Если поднимаешь `pnpm dev:tunnel`
# (нужен только для тестов Telegram-бота), скрипт перепишет это значение на
# Cloudflare-туннель — после теста верни обратно на http://localhost:3020/api,
# иначе фронт будет ходить в мёртвый туннель.
VITE_API_URL=http://localhost:3020/api

# Полный список переменных (CORS, Telegram, JWT, Sentry и т.д.) — см. .env.example