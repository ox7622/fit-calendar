        "prettier": "^2.6.2",
        "react-refresh": "^0.10.0",
        "tailwindcss": "^4.1.18",
        "tailwindcss-animate": "^1.0.7",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
