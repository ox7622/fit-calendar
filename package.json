        "pino": "^10.2.0",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "react-router-dom": "6.29.0",
        "reflect-metadata": "^0.1.13",
