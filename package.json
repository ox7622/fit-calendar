        "typeorm": "^0.3.24",
        "yaml": "^2.8.0",
        "yargs": "^18.0.0",
        "zustand": "^5.0.11"
    },
    "lint-staged": {
        "*.{js,ts,tsx,jsx,json}": "prettier --write --ignore-unknown"
    }
}
