# Шаблон конфига для install.sh — KEY=VALUE, шелл-синтаксис (`source`-friendly).
#
# Скопируй на сервере под безопасным именем и chmod 600, чтобы не светить
# секреты в `ps aux` и истории shell:
#   scp install.env.example root@server:/root/install.env
#   ssh root@server "chmod 600 /root/install.env && nano /root/install.env"
#
# Запуск:
#   sudo bash install.sh --config-file /root/install.env
#
# Любой флаг командной строки перекрывает значение из файла.
# Пустые/закомментированные строки пропускаются.

# ─── Обязательное ────────────────────────────────────────────────────────────
DOMAIN=club.ru
ACME_EMAIL=owner@club.ru
TG_BOT_TOKEN=1234567890:AAA-BBB-CCC
ADMIN_EMAIL=owner@club.ru

# ─── Опциональное ────────────────────────────────────────────────────────────
# Если пусто — сгенерируются автоматически и будут напечатаны в конце установки.
ADMIN_PASSWORD=
ADMIN_NAME=Owner
JWT_SECRET=
DB_PASS=
TG_WEBHOOK_SECRET=

# Cloudinary (загрузка фото) — оставь пусто, чтобы выключить
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry — DSN'ы из трёх проектов sentry.io
# Заводи ОДИН раз на компанию, для каждого клуба используешь те же три DSN.
SENTRY_DSN=
VITE_SENTRY_DSN_MINI=
VITE_SENTRY_DSN_ADMIN=

# ─── Бэкап БД в S3-совместимое хранилище ─────────────────────────────────────
# Если задан BACKUP_S3_BUCKET (+ ключи), install.sh поставит cron на каждый день в 03:00.
BACKUP_S3_BUCKET=fitcalendar-backups-clubru
BACKUP_S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
BACKUP_S3_REGION=ru-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Расписание (cron-формат). Default: 0 3 * * * = каждый день в 03:00 локального времени.
BACKUP_CRON_SCHEDULE=0 3 * * *

# Telegram-бот для алертов о падении бэкапа (НЕ клиентский бот клуба).
# Один служебный бот можно использовать на все клубы.
BACKUP_ALERT_BOT_TOKEN=
BACKUP_ALERT_CHAT_ID=

# ─── UptimeRobot (мониторинг доступности) ────────────────────────────────────
# Если задан — install.sh создаст HTTPS keyword-monitor на api.<DOMAIN>/api/health
UPTIMEROBOT_KEY=
