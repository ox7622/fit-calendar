{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "baseUrl": ".",
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": ["es2020", "dom"],
        "sourceMap": true,
        "declaration": false,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "importHelpers": true,
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "strict": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "resolveJsonModule": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "isolatedModules": true,
        "noUncheckedIndexedAccess": true,
        "strictPropertyInitialization": false,
        "jsx": "react-jsx",
        "paths": {
            "@fitcalendar/bot-core": ["libs/bot-core/src/index.ts"],
            "@fitcalendar/db": ["libs/db/src/index.ts"],
            "@fitcalendar/nest-shared": ["libs/nest-shared/src/index.ts"],
            "@fitcalendar/sdk/*": ["libs/sdk/src/*"],
            "@fitcalendar/shared": ["libs/shared/src/index.ts"],
            "@fitcalendar/ui": ["libs/ui/src/index.ts"]
        },
        "typeRoots": ["libs/sdk/src/types", "libs/nest-shared/src/types", "node_modules/@types"]
    },
    "exclude": ["node_modules", "tmp"]
}
